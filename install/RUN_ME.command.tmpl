#!/usr/bin/env bash
# ============================================================================
# MEMS26 — RUN ME (double-click on the NEW Mac)
#
# One-touch install. This file sits next to `mems26.gitbundle` + `env.copy`
# inside the bundle you copied over. It: unpacks the code → drops your .env →
# runs the full installer → points you at the (short) Sierra-study checklist.
#
# Your other Mac ALREADY has Sierra installed — so you only need to deploy the
# study + set its Inputs, not install Sierra or its license.
# ============================================================================
set -uo pipefail
cd "$(dirname "$0")"

DEST="${MEMS26_DEST:-$HOME/mems26/mems26_web_git}"
say() { printf '\033[1;36m[RUN_ME]\033[0m %s\n' "$*"; }
err() { printf '\033[1;31m[RUN_ME][err]\033[0m %s\n' "$*" >&2; }

say "installing MEMS26 → $DEST"

# 1. Code from the bundle (carries unpushed commits — no GitHub needed).
if [ -d "$DEST/.git" ]; then
  say "repo already at $DEST — pulling from bundle"
  ( cd "$DEST" && git pull "$OLDPWD/mems26.gitbundle" HEAD 2>/dev/null || true )
else
  mkdir -p "$(dirname "$DEST")"
  git clone mems26.gitbundle "$DEST" || { err "git clone failed"; exit 1; }
  if [ -f GIT_HEAD.txt ]; then ( cd "$DEST" && git checkout "$(sed -n 2p ../GIT_HEAD.txt 2>/dev/null || echo main)" 2>/dev/null || true ); fi
fi

# 2. Your .env (flags + token + paths) — only if not already present.
if [ -f "$DEST/.env" ]; then
  say ".env already present at destination — keeping it"
elif [ -f env.copy ]; then
  cp env.copy "$DEST/.env" && chmod 600 "$DEST/.env" && say ".env installed (chmod 600)"
fi

# 3. Full installer (deps, DB, frontend, LaunchAgents, verify).
say "running install/install_mems26.sh"
bash "$DEST/install/install_mems26.sh" --repo "$DEST"

cat <<EOF

============================================================================
 ✅ MEMS26 code + services are up. LAST STEP — Sierra study (Sierra is already
    installed on this Mac, so this is the SHORT version):
      1. Deploy the study:  cd $DEST && scripts/build_monolithic_cpp.sh --deploy
      2. In Sierra: Analysis → Build Custom Studies DLL → Remote Build (0 errors)
      3. Add MES_AI_DataExport to your MES 5-min chart
      4. Study Input-4 (export dir) = \$HOME/SierraChart_Data/v9_export/
      5. Set the contract (e.g. MESU26) · Input-21 EnableOrderPlacement = 0 until ready
      6. Confirm \$HOME/SierraChart_Data/v9_export/*.json update ≤2s in RTH
    Full list: $DEST/install/SIERRA_SETUP_CHECKLIST.md
============================================================================
EOF
say "done — press any key to close."; read -r -n 1 _ || true
