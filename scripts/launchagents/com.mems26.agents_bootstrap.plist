<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- T-259 root (05.10.2026): macOS Background Task Management attributes a
	     LaunchAgent to ProgramArguments[0]. The six Python-launched agents are
	     attributed to "Python / Ned Deily" and sit DISALLOWED in BTM
	     (sfltool dumpbtm: activity_feed, export_promoter, mobile_relay), so
	     login never registers them. The three bash-launched agents are
	     attributed to bash and are ALLOWED - this one is bash too, and it
	     bootstraps whatever is missing via the idempotent, trade-safe
	     scripts/mems26_bootstrap_agents.sh (relay only when flat + no pending cmd).
	     bash exec's Python.app (the backend's own pattern): BTM attributes the
	     item to bash (allowed), TCC sees Python.app (has the folder grants) -
	     plain bash gets "Operation not permitted" on ~/Downloads. -->
	<key>Label</key>
	<string>com.mems26.agents_bootstrap</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>sleep 40; exec /Library/Frameworks/Python.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python -c 'import subprocess,sys; sys.exit(subprocess.run(["/bin/bash","/Users/michael/Downloads/mems26_web_git/scripts/mems26_bootstrap_agents.sh","--bootstrap"]).returncode)'</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>600</integer>
	<key>StandardOutPath</key>
	<string>/tmp/mems26_agents_bootstrap.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/mems26_agents_bootstrap.log</string>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
</dict>
</plist>
