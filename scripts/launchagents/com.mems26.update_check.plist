<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mems26.update_check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>bash "$HOME/mems26/mems26_web_git/scripts/mems26_update_check.sh" 2>/dev/null || bash "$HOME/Downloads/mems26_web_git/scripts/mems26_update_check.sh" 2>/dev/null</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/mems26_update_check.err.log</string>
</dict>
</plist>
