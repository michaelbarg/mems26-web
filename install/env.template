# ============================================================================
# MEMS26 .env — machine config + trading-flag baseline
# ============================================================================
# install_mems26.sh copies this to <repo>/.env and substitutes the __PLACEHOLDERS__.
# Named `env.template` (NOT `.env.example`) on purpose: .gitignore has `.env.*`,
# so a dotted name would be untracked. Keep secrets OUT of git — the installer
# fills them at install time.
#
# TWO KINDS OF KEYS BELOW:
#   (A) MACHINE-SPECIFIC + SECRETS — the installer sets these per machine.
#   (B) TRADING-FLAG BASELINE — a DATED known-good snapshot. The live source of
#       truth for flag state is docs/FLAG_INDEX.md (generated). Re-check it after
#       install; standing-OFF flags must stay OFF (CLAUDE.md §Standing Decisions).
# ============================================================================

# ---- (A) MACHINE-SPECIFIC ----------------------------------------------------
# Local Postgres ONLY (localhost/127.0.0.1). NEVER a cloud/Render/Upstash PG URL.
DATABASE_URL=postgresql://localhost/mems26

# Where the Sierra study writes its JSON exports on THIS machine.
V9_EXPORT_DIR=__EXPORT_DIR__
V9_CUMDELTA_EXPORT_PATH=__EXPORT_DIR__/cumulative_delta.json

# Bridge auth token (shared secret between bridge and backend). CHANGE THIS per
# machine; the installer generates a random one if you don't supply it.
BRIDGE_TOKEN=__BRIDGE_TOKEN__

# Bridge target — HARD localhost. The bridge refuses to start otherwise.
CLOUD_URL=http://localhost:8000

# Mode marker (informational).
MEMS26_MODE=local

# ---- Optional cloud mirror (leave blank for a pure-local trading box) --------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# MEMS26_DRIVE_MIRROR_FOLDER_ID=
# MEMS26_SIGNALS_DIR=

# ============================================================================
# ---- (B) TRADING-FLAG BASELINE — known-good as of 2026-07-03 ----------------
# Verify against docs/FLAG_INDEX.md after install. Do NOT flip standing-OFF
# flags on without Michael's sign-off (CLAUDE.md §Standing Decisions).
# ============================================================================

