<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — install_mems26.sh substitutes __REPO__ / __PYTHON__ / __EXPORT_DIR__ / __BRIDGE_TOKEN__.
  CLOUD_URL is HARD-PINNED to http://localhost:8000 — CLAUDE.md §Bridge Local-Only Rule. Never a cloud URL.
  Conditional KeepAlive (restart on failure) per CLAUDE.md §LaunchAgent Stability.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mems26.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd __REPO__ &amp;&amp; [ -f .env ] &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a; export V9_EXPORT_DIR="${V9_EXPORT_DIR:-__EXPORT_DIR__}"; export CLOUD_URL="http://localhost:8000"; export BRIDGE_TOKEN="${BRIDGE_TOKEN:-__BRIDGE_TOKEN__}"; export V9_DISABLE_WATCHDOG="${V9_DISABLE_WATCHDOG:-1}"; exec __PYTHON__ bridge/json_bridge.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/bridge.err.log</string>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
