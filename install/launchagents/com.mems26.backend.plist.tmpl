<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — install_mems26.sh substitutes __REPO__ / __PYTHON__ / __EXPORT_DIR__ / __BRIDGE_TOKEN__.
  Conditional KeepAlive (restart only on failure) per CLAUDE.md §LaunchAgent Stability — do NOT change to KeepAlive=true.
  The inline exports are engine invariants (relative modes + disabled legacy systems); trading flags come from .env.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mems26.backend</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd __REPO__ &amp;&amp; [ -f .env ] &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a; export DATABASE_URL="${DATABASE_URL:-postgresql://localhost/mems26}"; export V9_EXPORT_DIR="${V9_EXPORT_DIR:-__EXPORT_DIR__}"; export BRIDGE_TOKEN="${BRIDGE_TOKEN:-__BRIDGE_TOKEN__}"; export V9_DISABLE_WATCHDOG="${V9_DISABLE_WATCHDOG:-1}"; export S2_ATR_RELATIVE=true; export S3_RELATIVE=true; export S1_IB_WIDTH_ATR=true; export S1_CVD_OPENING=true; export S1_DAYTYPE_STAGING=true; export S1_DYNAMIC_RECLASS=true; export S4_EXTREME_TREND_RELABEL=true; export FOOTPRINT_DISABLED=true; export TICK_REVERSAL_DISABLED=true; export WOODIES_30MIN_DISABLED=true; export S2_VSA_VOLUME=true; export S1_LIVE_RECLASS=true; exec __PYTHON__ -m uvicorn backend.main:app --host 127.0.0.1 --port 8000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/backend.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/backend.err.log</string>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
